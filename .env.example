# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)

# 서비스 주소 (로컬은 그대로, 배포 후에는 실제 도메인)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase › Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 키. 절대 공개 저장소나 클라이언트 코드에 노출하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 카카오 개발자 › 내 애플리케이션 › 앱 키 › JavaScript 키 (카카오톡 공유용, M6 에서 사용)
NEXT_PUBLIC_KAKAO_JS_KEY=
