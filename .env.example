# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)

# 서비스 주소 (로컬은 그대로, 배포 후에는 실제 도메인)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase › Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 키. 절대 공개 저장소나 클라이언트 코드에 노출하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 기기·IP 해시와 "내 메시지" 쿠키 서명에 쓰는 서버 비밀값 (임의의 긴 문자열, 예: openssl rand -hex 32)
# 비워 두면 service role 키에서 파생한다. 한 번 정하면 바꾸지 않는다 (바꾸면 작성 제한 기록·내 메시지 쿠키가 초기화된다).
MM_SECRET=

# 카카오 개발자 › 내 애플리케이션 › 앱 키 › JavaScript 키 (카카오톡 공유용. 없으면 기기 공유 시트 → 링크 복사로 대체)
NEXT_PUBLIC_KAKAO_JS_KEY=
